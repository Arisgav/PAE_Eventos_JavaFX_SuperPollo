<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?xml version="1.0" encoding="UTF-8"?>
<BorderPane fx:id="mainLayout" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.MainController">
    <left>
        <VBox prefWidth="200.0" spacing="15.0" style="-fx-background-color: #2b3e50; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Navegación" />
            <Button maxWidth="Infinity" onAction="#cargarReto1" text="1. Pulpería" />
            <Button maxWidth="Infinity" onAction="#cargarReto2" text="2. Recepción Café" />
            <Button maxWidth="Infinity" onAction="#cargarReto3" text="3. Artesanías" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER">
            <Label style="-fx-font-size: 20px;" text="Seleccione un reto del menú lateral" />
        </VBox>
    </center>
</BorderPane>