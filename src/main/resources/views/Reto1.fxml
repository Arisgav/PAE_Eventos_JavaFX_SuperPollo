<?xml version="1.0" encoding="UTF-8"?>


<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.pae_eventos_javafx_equipo_2.controllers.Reto1Controller">
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Reto 1: Inventario de Pulpería" />
    <GridPane hgap="10" vgap="10">
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Button onAction="#guardarProducto" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Guardar Producto" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>
    <Label text="Buscador:" />
    <TextField fx:id="txtBuscar" onKeyPressed="#buscarProducto" promptText="Presiona ENTER para buscar..." />
</VBox>